# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
LANGSMITH_API_KEY=          # ใช้ใน Part 18+ (สมัครฟรีที่ smith.langchain.com)
LANGSMITH_TRACING=false      # เปิดเฉพาะตัวอย่างที่ต้องการ trace (free plan มี quota จำกัด)
LANGSMITH_PROJECT=langchain-course
DATABASE_URL=postgres://langchain:langchain@localhost:5435/langchain_course   # ใช้ Part 12, 15–16 (docker compose up -d)
