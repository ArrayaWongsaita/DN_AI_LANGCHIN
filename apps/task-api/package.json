{
  "name": "task-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Task Manager backend (NestJS + Prisma + PostgreSQL) — Part 19 / 20",
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "node --env-file=../../.env ./node_modules/prisma/build/index.js",
    "migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "db:create": "tsx --env-file=../../.env scripts/create-db.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "eval:summary": "tsx --env-file=../../.env eval/summary-eval.ts"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/deepseek": "1.1.26",
    "@langchain/google-genai": "2.3.7",
    "@langchain/groq": "1.3.2",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/mcp-adapters": "2.0.3",
    "@langchain/textsplitters": "1.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "langchain": "1.6.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
